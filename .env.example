# ÖlçekLab ortam değişkenleri. Bu dosyayı .env olarak kopyalayın; .env depoya eklenmez.

# --- Ön yüz (derleme zamanında okunur) ---
VITE_ENGINE_URL=http://localhost:8000
VITE_AI_GATEWAY_URL=http://localhost:8787

# --- R motoru ve ağ geçidi: izin verilen ön yüz kaynakları (virgülle ayrılır) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Yapay zekâ (SPEC M11). Varsayılan: none ---
# none | local | evren
AI_PROVIDER=none

# local: Ollama ya da llama.cpp (OpenAI uyumlu). Model adı SPEC §14 madde 3'e göre seçilecek.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=

# evren: değerler EVREN belgeleri alınınca doldurulacak (SPEC §14 madde 1). Varsayılan yoktur.
EVREN_BASE_URL=
EVREN_API_KEY=
EVREN_MODEL=

# --- R motoru işçileri ve çevrim içi mod sınırları (SPEC M9 9.7) ---
ENGINE_WORKERS=2
ONLINE_LIMITS=false
ONLINE_MAX_REPLICATIONS_X_CONDITIONS=2000
ONLINE_MAX_WORKERS=2
ONLINE_JOB_TIMEOUT_SECONDS=3600

# api (v1.3): OpenAI uyumlu bulut API. Sağlayıcı ve model belge sahibince seçilir; varsayılan yoktur.
# Anahtar çevrim içi modda yalnızca Hugging Face Space Secrets'a girilir, depoya yazılmaz.
AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL=
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_OUTPUT_TOKENS=
